@using HanLearn.Web.Client.Data
<div class="border border-primary rounded p-3 shadow-sm">
	@Card?.CardFront.Character
	@if (_showAnswer)
	{
		<p>@Card?.CardBack.Example</p>
		<p>
			@if(Card != null)
			{
				@foreach (string pronounciation in Card.CardBack.Pronunciation)
				{
					@pronounciation
				}
			}
		</p>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Again)">Again</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Hard)">Hard</button	>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Good)">Good</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Easy)">Easy</button>
	}



	<button @onclick="showAnswer"> Show answer </button>
</div>

















@code
{
	[Parameter]
	public StudyCard? Card { get; set; }
	[Parameter]
	public EventCallback<Rating> OnRatingSelected { get; set; }

	bool _showAnswer = false;
	private int? _previousCardId;
	private void showAnswer() { _showAnswer = !_showAnswer; }

	protected override void OnParametersSet()
	{
		if (Card?.Id != _previousCardId)
		{
			_showAnswer = false;
			_previousCardId = Card?.Id;
		}
	}
}
