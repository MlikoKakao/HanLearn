@using FSRS.Core.Models
@using FSRS.Core.Enums

@using HanLearn.Web.Client.Data
<div class="border border-primary rounded p-3 shadow-sm">
    @Sense.WrittenForm
		@if (_showAnswer)
		{
			<p>@Sense.Example</p>
			<p>@string.Join("、", Sense.Pronunciations)</p>
			<p>@Sense.Definition</p>
			<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Again)">Again</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Hard)">Hard</button	>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Good)">Good</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(Rating.Easy)">Easy</button>
	}



	<button @onclick="ToggleAnswer">Show answer</button>
</div>





@code
{
	[Parameter]
	public required LexicalSense Sense { get; set; }
	[Parameter]
	public EventCallback<Rating> OnRatingSelected { get; set; }

	private bool _showAnswer;
	private string? _previousSenseId;
	private void ToggleAnswer() => _showAnswer = !_showAnswer;

	protected override void OnParametersSet()
	{
		if (Sense.Id != _previousSenseId)
		{
			_showAnswer = false;
			_previousSenseId = Sense.Id;
		}
	}
}
