@using HanLearn.Web.Client.Data
<div class="border border-primary rounded p-3 shadow-sm">
		@(VocabularyEntry?.WrittenForm ?? CharacterEntry?.WrittenForm)
		@if (_showAnswer)
		{
			@if (VocabularyEntry is not null)
			{
				<p>@VocabularyEntry.Example</p>
				<p>@string.Join("、", VocabularyEntry.Pronunciations)</p>
				<p>@VocabularyEntry.Meaning</p>
			}
			else if (CharacterEntry is not null)
			{
				@foreach (CharacterReading reading in CharacterEntry.Readings)
				{
					<p>@reading.Pronunciations</p>
					<p>@string.Join("; ", reading.Meanings)</p>
				}
			}
			<button @onclick="() => OnRatingSelected.InvokeAsync(ReviewRating.Again)">Again</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(ReviewRating.Hard)">Hard</button	>
		<button @onclick="() => OnRatingSelected.InvokeAsync(ReviewRating.Good)">Good</button>
		<button @onclick="() => OnRatingSelected.InvokeAsync(ReviewRating.Easy)">Easy</button>
	}



	<button @onclick="ToggleAnswer">Show answer</button>
</div>

















@code
{
	[Parameter]
	public VocabularyEntry? VocabularyEntry { get; set; }
	[Parameter]
	public CharacterEntry? CharacterEntry { get; set; }
	[Parameter]
	public EventCallback<ReviewRating> OnRatingSelected { get; set; }

	private bool _showAnswer;
	private string? _previousEntryId;
	private void ToggleAnswer() => _showAnswer = !_showAnswer;

	protected override void OnParametersSet()
	{
			string? entryId = VocabularyEntry is not null
				? $"vocabulary:{VocabularyEntry.Id}"
				: CharacterEntry is not null
					? $"character:{CharacterEntry.Id}"
					: null;
			if (entryId != _previousEntryId)
			{
				_showAnswer = false;
				_previousEntryId = entryId;
		}
	}
}
