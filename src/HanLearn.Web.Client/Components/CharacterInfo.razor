@using HanLearn.Web.Client.Data

<div class="col-lg-5 mt-4 mt-lg-0">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3>@selectedCard.CardFront.Character</h3>
                <span>@string.Join("、", selectedCard.CardBack.Pronunciation)</span>           
                <span>@selectedCard.CardBack.Example</span>

        </div>
    </div>
</div>


@code
{
    [Parameter]
    public required StudyCard selectedCard { get; set; }
}