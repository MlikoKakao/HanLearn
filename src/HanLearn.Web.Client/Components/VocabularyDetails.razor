@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@inject VocabularyReviewStateService ReviewStateService

<div class="card shadow-sm">
    <div class="card-body">
        <h3>@Entry.WrittenForm</h3>
        <br />
        <span>@Entry.Meaning</span>
        <br />
        <span>@string.Join("、", Entry.Pronunciations)</span>
        <br />
        <span>@Entry.Example</span>
        <br />
        <button @onclick="addToReview">Add to Review</button>

    </div>
</div>


@code
{
    [Parameter]
    public required VocabularyEntry Entry { get; set; }

    private void addToReview()
    {
        ReviewStateService.AddToReview(Entry.Id);
    }
}
