@page "/"

<PageTitle>Learn Taiwan Mandarin | HanLearn</PageTitle>

<div class="landing-page">
    <section class="hero" aria-labelledby="home-heading">
        <p class="eyebrow">Traditional characters · Zhuyin first</p>
        <h1 id="home-heading">Read Taiwan Mandarin with less tool-switching.</h1>
        <p class="hero-copy">
            Build pronunciation, understand vocabulary in context, and review what you choose to learn.
        </p>
        <div class="hero-actions">
            <a class="primary-action" href="dialogues">Read a dialogue</a>
            <a class="secondary-action" href="zhuyin">Start with Zhuyin</a>
        </div>
    </section>

    <section class="study-paths" aria-labelledby="study-heading">
        <div class="section-heading">
            <p class="eyebrow">Choose your next step</p>
            <h2 id="study-heading">Study at your own pace</h2>
        </div>

        <div class="path-grid">
            <a class="path-card zhuyin-card" href="zhuyin">
                <span class="card-symbol" lang="zh-Bopo">ㄅ</span>
                <span class="card-content">
                    <span class="card-kicker">Build the foundation</span>
                    <span class="card-title">Learn Zhuyin</span>
                    <span class="card-description">Explore Taiwan's phonetic system and hear each symbol.</span>
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>

            <a class="path-card dialogue-card" href="dialogues">
                <span class="card-symbol" lang="zh-Hant">讀</span>
                <span class="card-content">
                    <span class="card-kicker">Learn through context</span>
                    <span class="card-title">Read dialogues</span>
                    <span class="card-description">Select words for contextual definitions, Zhuyin, and character details.</span>
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>

            <a class="path-card review-card" href="review">
                <span class="card-symbol" lang="zh-Hant">習</span>
                <span class="card-content">
                    <span class="card-kicker">Strengthen your memory</span>
                    <span class="card-title">Review vocabulary</span>
                    <span class="card-description">Practice the words you saved with spaced repetition.</span>
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</div>

