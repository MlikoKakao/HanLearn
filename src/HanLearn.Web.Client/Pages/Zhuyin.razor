@page "/zhuyin"
@using HanLearn.Web.Client.Components

<PageTitle>Zhuyin | HanLearn</PageTitle>

<div class="zhuyin-page">
    <header class="page-heading">
        <p class="eyebrow">Pronunciation foundation</p>
        <h1>Zhuyin</h1>
        <p class="page-introduction">
            Select a symbol to hear its sound, or use the existing exercise to cycle through the first symbols.
        </p>
        <a class="info-link" href="zhuyin/info">Why HanLearn starts with Zhuyin <span aria-hidden="true">→</span></a>
    </header>

    <section class="keyboard-section" aria-labelledby="keyboard-heading">
        <div class="section-heading">
            <div>
                <p class="section-label">Sound reference</p>
                <h2 id="keyboard-heading">Zhuyin keyboard</h2>
            </div>
            <span class="section-note">Select a key to listen</span>
        </div>

        <div class="keyboard-frame">
            <ZhuyinKeyboard />
        </div>
    </section>

    <section class="symbol-guide" aria-labelledby="symbol-guide-heading">
        <div class="guide-heading">
            <p class="section-label">Read-only study sets</p>
            <h2 id="symbol-guide-heading">Learn the symbols in families</h2>
            <p>Study one group at a time. Each example highlights the symbol inside a complete Mandarin syllable.</p>
        </div>


        <!--I don't really like this solution, revisit later.
            A user who just arrived will have no idea about any of the sounds
            so seeing "ㄇㄠ" doesn't tell them anything. Only solutions are:
                1. Pinyin as crutches in beginning
                2. Lots of listening content
            I learned with 1., but idk if that's correct-->
        <div class="symbol-groups">
            <section class="symbol-group" aria-labelledby="group-bpmf">
                <header><span class="group-number">01</span><h3 id="group-bpmf" lang="zh-Bopo">ㄅ ㄆ ㄇ ㄈ</h3><p>Lip sounds</p></header>
                <div class="example-grid">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄅ</span><span class="word" lang="zh-Hant">包</span><span class="reading" lang="zh-Bopo">ㄅㄠ</span><span class="meaning">bag</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄆ</span><span class="word" lang="zh-Hant">朋友</span><span class="reading" lang="zh-Bopo">ㄆㄥˊ ㄧㄡˇ</span><span class="meaning">friend</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄇ</span><span class="word" lang="zh-Hant">貓</span><span class="reading" lang="zh-Bopo">ㄇㄠ</span><span class="meaning">cat</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄈ</span><span class="word" lang="zh-Hant">飯</span><span class="reading" lang="zh-Bopo">ㄈㄢˋ</span><span class="meaning">rice; meal</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-dtnl">
                <header><span class="group-number">02</span><h3 id="group-dtnl" lang="zh-Bopo">ㄉ ㄊ ㄋ ㄌ</h3><p>Tongue-tip sounds</p></header>
                <div class="example-grid">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄉ</span><span class="word" lang="zh-Hant">大</span><span class="reading" lang="zh-Bopo">ㄉㄚˋ</span><span class="meaning">big</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄊ</span><span class="word" lang="zh-Hant">台灣</span><span class="reading" lang="zh-Bopo">ㄊㄞˊ ㄨㄢ</span><span class="meaning">Taiwan</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄋ</span><span class="word" lang="zh-Hant">你</span><span class="reading" lang="zh-Bopo">ㄋㄧˇ</span><span class="meaning">you</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄌ</span><span class="word" lang="zh-Hant">來</span><span class="reading" lang="zh-Bopo">ㄌㄞˊ</span><span class="meaning">come</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-gkh">
                <header><span class="group-number">03</span><h3 id="group-gkh" lang="zh-Bopo">ㄍ ㄎ ㄏ</h3><p>Back-of-mouth sounds</p></header>
                <div class="example-grid three-examples">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄍ</span><span class="word" lang="zh-Hant">高</span><span class="reading" lang="zh-Bopo">ㄍㄠ</span><span class="meaning">tall; high</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄎ</span><span class="word" lang="zh-Hant">看</span><span class="reading" lang="zh-Bopo">ㄎㄢˋ</span><span class="meaning">look; watch</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄏ</span><span class="word" lang="zh-Hant">好</span><span class="reading" lang="zh-Bopo">ㄏㄠˇ</span><span class="meaning">good</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-jqx">
                <header><span class="group-number">04</span><h3 id="group-jqx" lang="zh-Bopo">ㄐ ㄑ ㄒ</h3><p>Front-of-mouth sounds</p></header>
                <div class="example-grid three-examples">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄐ</span><span class="word" lang="zh-Hant">家</span><span class="reading" lang="zh-Bopo">ㄐㄧㄚ</span><span class="meaning">home; family</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄑ</span><span class="word" lang="zh-Hant">去</span><span class="reading" lang="zh-Bopo">ㄑㄩˋ</span><span class="meaning">go</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄒ</span><span class="word" lang="zh-Hant">小</span><span class="reading" lang="zh-Bopo">ㄒㄧㄠˇ</span><span class="meaning">small</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-zhchshr">
                <header><span class="group-number">05</span><h3 id="group-zhchshr" lang="zh-Bopo">ㄓ ㄔ ㄕ ㄖ</h3><p>Retroflex sounds</p></header>
                <div class="example-grid">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄓ</span><span class="word" lang="zh-Hant">中</span><span class="reading" lang="zh-Bopo">ㄓㄨㄥ</span><span class="meaning">middle</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄔ</span><span class="word" lang="zh-Hant">吃</span><span class="reading" lang="zh-Bopo">ㄔ</span><span class="meaning">eat</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄕ</span><span class="word" lang="zh-Hant">是</span><span class="reading" lang="zh-Bopo">ㄕˋ</span><span class="meaning">be; yes</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄖ</span><span class="word" lang="zh-Hant">人</span><span class="reading" lang="zh-Bopo">ㄖㄣˊ</span><span class="meaning">person</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-zcs">
                <header><span class="group-number">06</span><h3 id="group-zcs" lang="zh-Bopo">ㄗ ㄘ ㄙ</h3><p>Dental sibilants</p></header>
                <div class="example-grid three-examples">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄗ</span><span class="word" lang="zh-Hant">早</span><span class="reading" lang="zh-Bopo">ㄗㄠˇ</span><span class="meaning">early; morning</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄘ</span><span class="word" lang="zh-Hant">菜</span><span class="reading" lang="zh-Bopo">ㄘㄞˋ</span><span class="meaning">dish; vegetable</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄙ</span><span class="word" lang="zh-Hant">三</span><span class="reading" lang="zh-Bopo">ㄙㄢ</span><span class="meaning">three</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-medials">
                <header><span class="group-number">07</span><h3 id="group-medials" lang="zh-Bopo">ㄧ ㄨ ㄩ</h3><p>Medials</p></header>
                <div class="example-grid three-examples">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄧ</span><span class="word" lang="zh-Hant">一</span><span class="reading" lang="zh-Bopo">ㄧ</span><span class="meaning">one</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄨ</span><span class="word" lang="zh-Hant">五</span><span class="reading" lang="zh-Bopo">ㄨˇ</span><span class="meaning">five</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄩ</span><span class="word" lang="zh-Hant">雨</span><span class="reading" lang="zh-Bopo">ㄩˇ</span><span class="meaning">rain</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-simple-finals">
                <header><span class="group-number">08</span><h3 id="group-simple-finals" lang="zh-Bopo">ㄚ ㄛ ㄜ ㄝ</h3><p>Simple finals</p></header>
                <div class="example-grid">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄚ</span><span class="word" lang="zh-Hant">媽</span><span class="reading" lang="zh-Bopo">ㄇㄚ</span><span class="meaning">mother</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄛ</span><span class="word" lang="zh-Hant">我</span><span class="reading" lang="zh-Bopo">ㄨㄛˇ</span><span class="meaning">I; me</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄜ</span><span class="word" lang="zh-Hant">喝</span><span class="reading" lang="zh-Bopo">ㄏㄜ</span><span class="meaning">drink</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄝ</span><span class="word" lang="zh-Hant">夜</span><span class="reading" lang="zh-Bopo">ㄧㄝˋ</span><span class="meaning">night</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-compound-finals">
                <header><span class="group-number">09</span><h3 id="group-compound-finals" lang="zh-Bopo">ㄞ ㄟ ㄠ ㄡ</h3><p>Compound finals</p></header>
                <div class="example-grid">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄞ</span><span class="word" lang="zh-Hant">愛</span><span class="reading" lang="zh-Bopo">ㄞˋ</span><span class="meaning">love</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄟ</span><span class="word" lang="zh-Hant">杯</span><span class="reading" lang="zh-Bopo">ㄅㄟ</span><span class="meaning">cup</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄠ</span><span class="word" lang="zh-Hant">到</span><span class="reading" lang="zh-Bopo">ㄉㄠˋ</span><span class="meaning">arrive</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄡ</span><span class="word" lang="zh-Hant">有</span><span class="reading" lang="zh-Bopo">ㄧㄡˇ</span><span class="meaning">have</span></div>
                </div>
            </section>

            <section class="symbol-group" aria-labelledby="group-nasal-finals">
                <header><span class="group-number">10</span><h3 id="group-nasal-finals" lang="zh-Bopo">ㄢ ㄣ ㄤ ㄥ ㄦ</h3><p>Nasal and final sounds</p></header>
                <div class="example-grid five-examples">
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄢ</span><span class="word" lang="zh-Hant">安</span><span class="reading" lang="zh-Bopo">ㄢ</span><span class="meaning">peace</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄣ</span><span class="word" lang="zh-Hant">很</span><span class="reading" lang="zh-Bopo">ㄏㄣˇ</span><span class="meaning">very</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄤ</span><span class="word" lang="zh-Hant">忙</span><span class="reading" lang="zh-Bopo">ㄇㄤˊ</span><span class="meaning">busy</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄥ</span><span class="word" lang="zh-Hant">冷</span><span class="reading" lang="zh-Bopo">ㄌㄥˇ</span><span class="meaning">cold</span></div>
                    <div class="symbol-example"><span class="symbol" lang="zh-Bopo">ㄦ</span><span class="word" lang="zh-Hant">二</span><span class="reading" lang="zh-Bopo">ㄦˋ</span><span class="meaning">two</span></div>
                </div>
            </section>

            <section class="symbol-group tone-group" aria-labelledby="group-tones">
                <header><span class="group-number">11</span><h3 id="group-tones">The five tones</h3><p>One syllable, different meanings</p></header>
                <div class="example-grid five-examples">
                    <div class="symbol-example"><span class="symbol tone-symbol">1</span><span class="word" lang="zh-Hant">媽</span><span class="reading" lang="zh-Bopo">ㄇㄚ</span><span class="meaning">mother</span></div>
                    <div class="symbol-example"><span class="symbol tone-symbol">ˊ</span><span class="word" lang="zh-Hant">麻</span><span class="reading" lang="zh-Bopo">ㄇㄚˊ</span><span class="meaning">hemp</span></div>
                    <div class="symbol-example"><span class="symbol tone-symbol">ˇ</span><span class="word" lang="zh-Hant">馬</span><span class="reading" lang="zh-Bopo">ㄇㄚˇ</span><span class="meaning">horse</span></div>
                    <div class="symbol-example"><span class="symbol tone-symbol">ˋ</span><span class="word" lang="zh-Hant">罵</span><span class="reading" lang="zh-Bopo">ㄇㄚˋ</span><span class="meaning">scold</span></div>
                    <div class="symbol-example"><span class="symbol tone-symbol">˙</span><span class="word" lang="zh-Hant">嗎</span><span class="reading" lang="zh-Bopo">˙ㄇㄚ</span><span class="meaning">question particle</span></div>
                </div>
                <p class="tone-note">The first tone has no written mark in Zhuyin. The neutral-tone dot is written before the syllable in horizontal text.</p>
            </section>
        </div>
    </section>

    <section class="practice-callout" aria-labelledby="practice-heading">
        <div>
            <p class="section-label">Quick practice</p>
            <h2 id="practice-heading">Test the symbols</h2>
            <p>Cycle through the symbols currently included in the exercise.</p>
        </div>
        <a class="practice-link" href="zhuyinTest">Open exercise <span aria-hidden="true">→</span></a>
    </section>
</div>
