@page "/dialogues/{StoryId:int}"
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Components
@inject StoryCatalog StoryCatalog
@inject VocabularyCatalog VocabularyCatalog


<p>Story Id: @StoryId</p>

@if (_selectedEntry != null)
{
	<VocabularyDetails Entry="_selectedEntry" />
}



@if (_story != null)
{
    @foreach (StorySegment segment in _story.Segments)
    {
        <span @onclick="() => SelectVocabularyEntry(segment.VocabularyEntryId)">@segment.Text</span>
    }
}

@code
{
    [Parameter]
    public required int StoryId { get; set; }

    private Story? _story;
    private VocabularyEntry? _selectedEntry;

    protected override void OnParametersSet()
    {
        _story = StoryCatalog.Stories.FirstOrDefault(story => story.Id == StoryId);
    }

	private void SelectVocabularyEntry(int? id)
	{
        if (id != null)
        {
		    _selectedEntry = VocabularyCatalog.Entries.FirstOrDefault(
			entry => entry.Id == id);
        }
    }
}
