@page "/dialogues/{StoryId}"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@inject StoryCatalog StoryCatalog
@inject VocabularyCatalog VocabularyCatalog


@if (_story != null)
{
    <PageTitle>@_story.Title</PageTitle>
    <h1>@_story.Title</h1>

    @if (_selectedEntry != null)
    {
        <VocabularyDetails Entry="_selectedEntry" />
    }

    <article class="story-body" aria-label="Story text">
    @foreach (StorySegment segment in _story.Segments)
    {
        @if (segment.Text == "\n\n")
        {
            <br />
            <br />
        }
        else if (segment.VocabularyEntryId is not null)
        {
            <span
                class="story-text @(segment.Id == _selectedSegmentId ? "selected-word" : null)"
                @onmouseenter="() => SelectVocabularyEntry(segment.VocabularyEntryId)"
                @onclick="() => SelectSegment(segment)"
                @onfocus="() => SelectVocabularyEntry(segment.VocabularyEntryId)"
                tabindex="0">
                @segment.Text
            </span>
        }
        else
        {
            @segment.Text
        }
    }
    </article>
}

@code
{
    [Parameter]
    public required string StoryId { get; set; }

    private Story? _story;
    private VocabularyEntry? _selectedEntry;
    private string? _selectedSegmentId;
    protected override void OnParametersSet()
    {
        _story = StoryCatalog.Stories.FirstOrDefault(story => story.Id == StoryId);
    }

    private void SelectVocabularyEntry(string? id)
    {
        if (id != null)
        {
            _selectedEntry = VocabularyCatalog.Entries.FirstOrDefault(
            entry => entry.Id == id);
        }
    }

    private void SelectSegment(StorySegment segment)
    {
        _selectedSegmentId = segment.Id;
        SelectVocabularyEntry(segment.VocabularyEntryId);
    }
}
