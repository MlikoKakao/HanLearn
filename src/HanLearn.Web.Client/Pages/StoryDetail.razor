@page "/dialogues/{StoryId}"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@inject StoryCatalog StoryCatalog
@inject VocabularyCatalog VocabularyCatalog


@if (_story != null)
{
    <PageTitle>@_story.Title</PageTitle>
    <h1>@_story.Title</h1>

    <article class="story-body" aria-label="Story text">
    @foreach (StorySegment segment in _story.Segments)
    {
        @if (segment.Text == "\n\n")
        {
            <br />
            <br />
        }
        else if (segment.VocabularyEntryId is not null)
        {
            <div class="story-word-anchor"
                 @onmouseenter="() => ShowVocabularyEntry(segment)"
                 @onmouseleave="() => HideVocabularyEntry(segment)">
                <span
                    class="story-text @(segment.Id == _selectedSegmentId ? "selected-word" : null)"
                    @onclick="() => SelectSegment(segment)"
                    @onfocus="() => ShowVocabularyEntry(segment)"
                    tabindex="0">
                    @segment.Text
                </span>

                @if (_activeSegmentId == segment.Id && _selectedEntry is not null)
                {
                    <div class="word-popover">
                        <VocabularyDetails Entry="_selectedEntry" />
                    </div>
                }
            </div>
        }
        else
        {
            @segment.Text
        }
    }
    </article>
}

@code
{
    [Parameter]
    public required string StoryId { get; set; }

    private Story? _story;
    private VocabularyEntry? _selectedEntry;
    private string? _activeSegmentId;
    private string? _selectedSegmentId;
    protected override void OnParametersSet()
    {
        _story = StoryCatalog.Stories.FirstOrDefault(story => story.Id == StoryId);
    }

    private void ShowVocabularyEntry(StorySegment segment)
    {
        _activeSegmentId = segment.Id;
        _selectedEntry = VocabularyCatalog.Entries.FirstOrDefault(
            entry => entry.Id == segment.VocabularyEntryId);
    }

    private void HideVocabularyEntry(StorySegment segment)
    {
        if (_selectedSegmentId != segment.Id)
        {
            _activeSegmentId = _selectedSegmentId;
            _selectedEntry = FindSelectedEntry();
        }
    }

    private void SelectSegment(StorySegment segment)
    {
        _selectedSegmentId = _selectedSegmentId == segment.Id ? null : segment.Id;
        _activeSegmentId = _selectedSegmentId ?? segment.Id;
        _selectedEntry = VocabularyCatalog.Entries.FirstOrDefault(
            entry => entry.Id == segment.VocabularyEntryId);
    }

    private VocabularyEntry? FindSelectedEntry()
    {
        return _story?.Segments
            .FirstOrDefault(segment => segment.Id == _selectedSegmentId)
            ?.VocabularyEntryId is string entryId
                ? VocabularyCatalog.Entries.FirstOrDefault(entry => entry.Id == entryId)
                : null;
    }
}
