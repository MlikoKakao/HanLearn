@page "/dialogues/{Id:int}"
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Components
@inject StoryCatalog StoryCatalog
@inject VocabularyCatalog VocabularyCatalog


<p>Story Id: @Id</p>

@if (_selectedEntry != null)
{
	<VocabularyDetails Entry="_selectedEntry" />
}



@if (_story != null)
{
    @foreach (string segment in _story.Segments)
    {
        <span @onclick="() => SelectVocabularyEntry(segment)">@segment</span>
    }
}

@code
{
    [Parameter]
    public required int Id { get; set; }

    private Story? _story;
    private VocabularyEntry? _selectedEntry;

    protected override void OnParametersSet()
    {
        _story = StoryCatalog.Stories.FirstOrDefault(story => story.Id == Id);
    }

	private void SelectVocabularyEntry(string writtenForm)
	{
		_selectedEntry = VocabularyCatalog.Entries.FirstOrDefault(
			entry => entry.WrittenForm == writtenForm);
	}
}
