@page "/dialogues/{StoryId}"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@inject StoryCatalog StoryCatalog
@inject Lexicon Lexicon


<div class="reader-page">
    <nav class="reader-navigation" aria-label="Reader navigation">
        <a href="dialogues"><span aria-hidden="true">←</span> All dialogues</a>
    </nav>

    @if (_story is not null)
    {
        <PageTitle>@_story.Title | HanLearn</PageTitle>
        <h1 lang="zh-Hant">@_story.Title</h1>
        <article class="story-body" lang="zh-Hant" aria-label="Story text" @onkeydown="HandleReaderKeyDown">
                @foreach (StoryOccurrence occurrence in _story.Occurrences)
                {
                    @if (occurrence.LexicalSenseId is not null)
                    {
                        <div class="story-word-anchor"
                              @onmouseenter="() => ShowLexicalSense(occurrence)"
                              @onmouseleave="() => HideLexicalSense(occurrence)">
                            <button type="button"
                                    class="story-text @(occurrence.Id == _selectedOccurrenceId ? "selected-word" : null)"
                                    aria-expanded="@(_activeOccurrenceId == occurrence.Id ? "true" : "false")"
                                    aria-controls="@($"gloss-{occurrence.Id}")"
                                    @onclick="() => SelectOccurrence(occurrence)"
                                    @onfocus="() => ShowLexicalSense(occurrence)">@occurrence.Text</button>
                            @if (_activeOccurrenceId == occurrence.Id && _selectedSense is not null)
                            {
                                <div class="word-popover" id="@($"gloss-{occurrence.Id}")" lang="en"
                                      role="region" aria-label="Word details for @occurrence.Text">
                                    <span class="popover-heading">
                                        <span>Word in context</span>
                                        <button type="button" aria-label="Close word details" @onclick="ClearSelection">×</button>
                                    </span>
                                    <LexicalSenseDetails Sense="_selectedSense" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @occurrence.Text
                    }
                }
            </article>
    }
    else
    {
        <PageTitle>Dialogue not found | HanLearn</PageTitle>
        <section class="missing-story">
            <h1>Dialogue not found</h1>
            <p>This dialogue isn’t available. Choose a reading from the library to continue.</p>
            <a href="dialogues">Browse dialogues →</a>
        </section>
    }
</div>

@code
{
    [Parameter]
    public required string StoryId { get; set; }

    private Story? _story;
    private LexicalSense? _selectedSense;
    private string? _activeOccurrenceId;
    private string? _selectedOccurrenceId;
    private string? _previousStoryId;

    protected override void OnParametersSet()
    {
        if (_previousStoryId != StoryId)
        {
            ClearSelection();
            _previousStoryId = StoryId;
        }
        _story = StoryCatalog.Stories.FirstOrDefault(story => story.Id == StoryId);
    }

    private void ShowLexicalSense(StoryOccurrence occurrence)
    {
        _activeOccurrenceId = occurrence.Id;
        _selectedSense = occurrence.LexicalSenseId is string senseId
            ? Lexicon.FindSense(senseId)
            : null;
    }

    private void HideLexicalSense(StoryOccurrence occurrence)
    {
        if (_selectedOccurrenceId != occurrence.Id)
        {
            _activeOccurrenceId = _selectedOccurrenceId;
            _selectedSense = FindSelectedSense();
        }
    }

    private void SelectOccurrence(StoryOccurrence occurrence)
    {
        if (_selectedOccurrenceId == occurrence.Id)
        {
            ClearSelection();
            return;
        }
        _selectedOccurrenceId = occurrence.Id;
        ShowLexicalSense(occurrence);
    }

    private void ClearSelection()
    {
        _selectedOccurrenceId = null;
        _activeOccurrenceId = null;
        _selectedSense = null;
    }

    private void HandleReaderKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ClearSelection();
        }
    }

    private LexicalSense? FindSelectedSense()
    {
        return _story?.Occurrences
            .FirstOrDefault(occurrence => occurrence.Id == _selectedOccurrenceId)
            ?.LexicalSenseId is string senseId
                ? Lexicon.FindSense(senseId)
                : null;
    }

}
