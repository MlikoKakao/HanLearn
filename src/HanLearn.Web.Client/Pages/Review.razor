@page "/review"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Data
@inject VocabularyCatalog VocabularyCatalog
@inject VocabularyReviewStateService ReviewStateService

<PageTitle>Review</PageTitle>

<h1>Review</h1>
@if (ReviewStateService.ReviewStates.Count == 0)
{
	<span>You have no cards to review!</span>
}
else
{
<ReviewCard
	Entry="@_currentEntry"
	OnRatingSelected="@RatingSelected" 
	/>
}



@code {
	private VocabularyEntry? _currentEntry;
	private int _entryIndex;

	private void RatingSelected(ReviewRating rating)
	{
		_entryIndex = (_entryIndex + 1) % VocabularyCatalog.Entries.Count;
		_currentEntry = VocabularyCatalog.Entries[_entryIndex];
	}

	protected override void OnParametersSet()
	{
		_currentEntry = VocabularyCatalog.Entries[0];
	}
}
