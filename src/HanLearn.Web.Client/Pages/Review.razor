@page "/review"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Data
@inject VocabularyCatalog VocabularyCatalog
@inject VocabularyReviewStateService ReviewStateService

<PageTitle>Review</PageTitle>

<h1>Review</h1>
@if (ReviewStateService.ReviewStates.Count == 0)
{
	<span>You have no cards to review!</span>
}
else
{
<ReviewCard
	Entry="@_currentEntry"
	OnRatingSelected="@RatingSelected" 
	/>
}



@code {
    private VocabularyEntry? _currentEntry;
    private int _entryIndex;
    IReadOnlyList<VocabularyEntry> vocabularyEntries = [];

    private void RatingSelected(ReviewRating rating)
    {
        _entryIndex = (_entryIndex + 1) % vocabularyEntries.Count;
        _currentEntry = vocabularyEntries[_entryIndex];
    }

    protected override void OnInitialized()
    {
        HashSet<string> savedIds = ReviewStateService.ReviewStates
            .Select(state => state.VocabularyEntryId)
            .ToHashSet();
        vocabularyEntries = VocabularyCatalog.Entries
        .Where(entry => savedIds.Contains(entry.Id))
        .ToList();

        if (vocabularyEntries.Count > 0)
        {
            _currentEntry = vocabularyEntries[0];
        }
    }
}
