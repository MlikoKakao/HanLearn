@page "/review"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Data
@inject VocabularyCatalog VocabularyCatalog
@inject VocabularyReviewStateService ReviewStateService

<PageTitle>Review</PageTitle>

<h1>Review</h1>
@if (ReviewStateService.ReviewStates.Count == 0)
{
	<span>You have no cards to review!</span>
}
else
{
<ReviewCard
		VocabularyEntry="@CurrentVocabularyEntry"
		CharacterEntry="@CurrentCharacterEntry"
		OnRatingSelected="@RatingSelected"
		/>
}



@code {
    private VocabularyReviewState? _currentReviewState;
    private int _entryIndex;
    private IReadOnlyList<VocabularyReviewState> _reviewStates = [];

    private VocabularyEntry? CurrentVocabularyEntry =>
        _currentReviewState?.Kind == ReviewItemKind.Vocabulary
            ? VocabularyCatalog.Entries.FirstOrDefault(entry => entry.Id == _currentReviewState.EntryId)
            : null;

    private CharacterEntry? CurrentCharacterEntry =>
        _currentReviewState?.Kind == ReviewItemKind.Character
            ? VocabularyCatalog.CharacterEntries.FirstOrDefault(entry => entry.Id == _currentReviewState.EntryId)
            : null;

    private void RatingSelected(ReviewRating rating)
    {
        _entryIndex = (_entryIndex + 1) % _reviewStates.Count;
        _currentReviewState = _reviewStates[_entryIndex];
    }

    protected override void OnInitialized()
    {
        _reviewStates = ReviewStateService.ReviewStates;

        if (_reviewStates.Count > 0)
        {
            _currentReviewState = _reviewStates[0];
        }
    }
}
