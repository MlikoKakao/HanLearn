@page "/review"
@using FSRS.Core.Enums
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Data
@using HanLearn.Web.Client.Services
@using System.Text.Json
@inject VocabularyCatalog VocabularyCatalog
@inject VocabularyReviewStateService ReviewStateService
@inject IJSRuntime JS

<PageTitle>Review</PageTitle>

<h1>Review</h1>

<button @onclick="ExportAsync">Export</button>

<label for="review-backup-file" class="btn btn-primary">
    Restore backup
</label>

<InputFile id="review-backup-file"
           class="visually-hidden"
           accept=".json,application/json"
           OnChange="ImportAsync" />

@if (_importError is not null)
{
    <p class="text-danger" role="alert">@_importError</p>
}

@if (_isLoading)
{
    <p>Loading reviews...</p>
}
else if (_currentReviewState is null)
{
	<span>You have no cards to review!</span>
}
else if (CurrentVocabularyEntry is VocabularyEntry entry)
{
    <ReviewCard Entry="@entry" OnRatingSelected="@RatingSelected" />
}
else
{
    <p>The vocabulary entry for this review card could not be found.</p>
}



@code {
    private VocabularyReviewState? _currentReviewState;
    private IReadOnlyList<VocabularyReviewState> _reviewStates = [];
    private string? _importError;

    private const long MaxImportFileSize = 500_000;

    private VocabularyEntry? CurrentVocabularyEntry =>
        _currentReviewState is null
            ? null
            : VocabularyCatalog.Entries.FirstOrDefault(
                entry => entry.Id == _currentReviewState.VocabularyEntryId);

    private bool _isLoading = true;
    private async Task RatingSelected(Rating rating)
    {
        if (_currentReviewState is not null)
        {
            await ReviewStateService.ReviewAsync(
                _currentReviewState.VocabularyEntryId,
                rating,
                DateTime.UtcNow);
            _reviewStates = ReviewStateService.GetDueCards();
            if (_reviewStates.Count > 0)
            {
                _currentReviewState = _reviewStates[0];
            }
            else
            {
                _currentReviewState = null;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }
        await ReviewStateService.LoadAsync();
        _reviewStates = ReviewStateService.GetDueCards();

        if (_reviewStates.Count > 0)
        {
            _currentReviewState = _reviewStates[0];
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async Task ExportAsync()
    {
        await ReviewStateService.LoadAsync();

        string json = ReviewStateService.Serialize();
        byte[] bytes = System.Text.Encoding.UTF8.GetBytes(json);

        using var fileStream = new MemoryStream(bytes);
        using var streamReference = new DotNetStreamReference(fileStream);

        await JS.InvokeVoidAsync("downloadFileFromStream",
        "hanlearn-review-data.json",
        streamReference);
    }


    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        _importError = null;

        if (file.Size > MaxImportFileSize)
        {
            _importError = "The selected file is too large. Review backups must be smaller than 500 KB.";
            return;
        }

        try
        {
            await using Stream stream = file.OpenReadStream(MaxImportFileSize);
            await ReviewStateService.ImportAsync(stream);

            _reviewStates = ReviewStateService.GetDueCards();
            _currentReviewState = _reviewStates.FirstOrDefault();
        }
        catch (JsonException)
        {
            _importError = "The selected file isn't a valid HanLearn review backup.";
        }
        catch (IOException)
        {
            _importError = "HanLearn couldn't read the selected file.";
        }

    }

}
