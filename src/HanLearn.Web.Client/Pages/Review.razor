@page "/review"
@using HanLearn.Web.Client.Components
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Data
@inject StudyCardCollectionService StudyCards

<PageTitle>Review</PageTitle>

<h1>Review</h1>
<StudyCardUI Card="@currentCard" />

@code {
	StudyCard currentCard;
	protected override void OnInitialized()
	{
		CardFront cardFront = new()
		{
			Character = "你好"
		};

		CardBack cardBack = new()
		{
			Pronunciation = ["ㄋ"],
			Example = "你好",
			Voice = "nihao.mp3"

		};


		StudyCards.AddCard(cardFront, cardBack);

		currentCard = StudyCards.Cards[0];
	}
}
