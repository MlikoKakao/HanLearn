@page "/zhuyinTest"
@using HanLearn.Web.Client.Services
@using HanLearn.Web.Client.Data
@inject ZhuyinCardCatalog CardCatalog

@if (cards.Count > 0)
{
	<div class="card bg-light mt-3">
		@CurrentCard.Symbol
	</div>
	<button @onclick="IncreaseIndex">
		Next
	</button>
}

@code {
	private IReadOnlyList<ZhuyinCard> cards = [];
	private int currentCardIndex;

	private ZhuyinCard CurrentCard => cards[currentCardIndex];

	protected override void OnInitialized()
	{
		cards = CardCatalog.Cards;
	}
	private void IncreaseIndex()
	{
		if (currentCardIndex < cards.Count() - 1)
		{
			currentCardIndex++;
		}
		else
		{
			currentCardIndex = 0;
		}
	}
}
